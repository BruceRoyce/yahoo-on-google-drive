# Never commit the configured .env. Use a Yahoo app password, not your login password.
YAHOO_USER=you@yahoo.com
YAHOO_APP_PASSWORD=
IMAP_HOST=imap.mail.yahoo.com
IMAP_PORT=993
ARCHIVE_DIR=./data
MAIL_ARCHIVE_SINCE=2024-09-01
REQUEST_INTERVAL_MS=300
MAX_MESSAGE_BYTES=104857600
RETRY_ATTEMPTS=4
# Optional Drive installed/desktop OAuth client. Configure only after local verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
